# Normalize line endings: LF in the repository, native in the working tree.
# Without this, a Windows-only project quietly commits CRLF and every diff from
# a non-Windows contributor looks like a full-file rewrite.
* text=auto eol=lf

# Windows-native files that must keep CRLF to work correctly.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary — never normalize, never diff as text.
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.ttf binary
*.woff binary
*.woff2 binary
*.msi binary
*.exe binary
*.dll binary
